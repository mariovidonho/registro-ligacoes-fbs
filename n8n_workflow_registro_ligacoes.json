    {
      "id": "928ee313-e601-4d76-8470-7fc4175a3220",
      "name": "Agregar por vendedor e periodo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        1250
      ],
      "parameters": {
        "jsCode": "\nconst q = $('Webhook: GET admin').first().json.query;\nconst tipo = q.tipo;\nconst valor = q.valor;\n\nconst vendedores = $('Ler aba Vendedores (admin)').all().map(i => i.json.Nome);\nconst rows = $('Ler aba Ligacoes (admin)').all().map(i => i.json);\n\nfunction matchPeriodo(dataIso){\n  if(!dataIso) return false;\n  if(tipo === 'dia') return dataIso.slice(0,10) === valor;\n  if(tipo === 'mes') return dataIso.slice(0,7) === valor;\n  if(tipo === 'ano') return dataIso.slice(0,4) === valor;\n  return true;\n}\nconst filtradas = rows.filter(r => matchPeriodo(r['Data/Hora']));\n\nconst porVendedor = {};\nfor(const v of vendedores){ porVendedor[v] = { vendedor: v, atendeu: 0, caixa: 0, lastTs: null }; }\nfor(const r of filtradas){\n  const v = r.Vendedor;\n  if(!porVendedor[v]) porVendedor[v] = { vendedor: v, atendeu: 0, caixa: 0, lastTs: null };\n  if(r.Tipo === 'atendeu') porVendedor[v].atendeu++;\n  else porVendedor[v].caixa++;\n  if(!porVendedor[v].lastTs || r['Data/Hora'] > porVendedor[v].lastTs) porVendedor[v].lastTs = r['Data/Hora'];\n}\n\nlet fechamentos = [];\nif(tipo === 'dia'){\n  fechamentos = $('Ler aba Fechamentos (admin)').all().map(i => i.json).filter(f => f.Data === valor);\n}\n\nconst ranking = Object.values(porVendedor).map(r => {\n  const fech = fechamentos.find(f => f.Vendedor === r.vendedor) || null;\n  return {\n    ...r,\n    total: r.atendeu + r.caixa,\n    closed: fech ? {\n      closedAt: fech['Fechado em'],\n      atendidas: fech.Atendidas,\n      caixaPostal: fech['Caixa Postal'],\n      total: fech.Total\n    } : null\n  };\n});\nranking.sort((a,b) => b.total - a.total);\nreturn [{ json: { ranking } }];\n"
      }
    },
