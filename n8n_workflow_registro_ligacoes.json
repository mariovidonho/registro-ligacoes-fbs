    {
      "id": "46edf506-39dd-433b-b490-e1069ff319f1",
      "name": "Filtrar por vendedor + hoje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        190
      ],
      "parameters": {
        "jsCode": "\nconst vendedor = $('Webhook: GET ligacoes').first().json.query.vendedor;\nconst hoje = new Date().toISOString().slice(0,10);\nconst ligacoes = $('Ler aba Ligacoes').all()\n  .map(i => i.json)\n  .filter(r => r.Vendedor === vendedor);\nconst fechamentoHoje = $('Ler aba Fechamentos').all()\n  .map(i => i.json)\n  .find(r => r.Vendedor === vendedor && r.Data === hoje) || null;\nreturn [{ json: { ligacoes, fechado: fechamentoHoje } }];\n"
      }
    },
