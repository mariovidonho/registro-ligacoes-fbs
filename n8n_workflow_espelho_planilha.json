    {
      "id": "b38d5ebd-9433-436d-ba56-018d68879f44",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -40
      ],
      "parameters": {
        "width": 1100,
        "height": 260,
        "content": "## Espelho Supabase -> Planilha\nO site grava no Supabase. A cada 10 min este fluxo reescreve as abas Ligações, Fechamentos, Metas e Vendedores com o conteúdo do banco (a linha de cabeçalho é mantida).\n\n**Só ATIVE depois de importar o histórico da planilha para o Supabase** — senão as linhas antigas somem da planilha na primeira execução.\n\nA planilha é só leitura: o que for editado nela à mão é sobrescrito na próxima execução."
      }
    },
    {
      "id": "b31edac3-955e-4f02-8bf9-6c064b2004b3",
      "name": "Buscar Ligacoes no Supabase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Busca a tabela inteira no Supabase (a API devolve no maximo 1000 linhas por vez).\n// Se vier vazia, nao devolve nada: o fluxo para aqui e a aba NAO e apagada.\nconst URL = 'https://cnwqzxrqxjatyqsnkxqx.supabase.co/rest/v1/ligacoes?select=*&order=ts,id';\nconst KEY = 'sb_publishable_A4bCcKHzh2XzmSCh6QXY4A_32aWwLuy';\nconst linhas = [];\nfor (let de = 0; ; de += 1000) {\n  const lote = await this.helpers.httpRequest({ url: `${URL}&offset=${de}&limit=1000`, headers: { apikey: KEY }, json: true });\n  linhas.push(...lote);\n  if (lote.length < 1000) break;\n}\nconst iso = t => t ? new Date(t).toISOString() : '';\nreturn linhas.map(r => ({ json: {\n  Vendedor: r.vendedor,\n  Tipo: r.tipo,\n  'Data/Hora': iso(r.ts),\n  Agendou: r.agendou || '',\n  'Chamou WhatsApp': r.chamou_whatsapp || ''\n} }));\n"
      }
    },
